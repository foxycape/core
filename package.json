{
  "name": "@foxycape/core",
  "version": "1.1.7",
  "description": "Browser-side multi-format reader kernel with pluggable parsers, renderers, services, and plugins.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://www.foxycape.com",
  "bugs": {
    "url": "https://github.com/foxycape/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxycape/core.git"
  },
  "main": "./dist/kernal/index.cjs",
  "module": "./dist/kernal/index.mjs",
  "types": "./dist/kernal/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kernal/index.d.ts",
      "import": "./dist/kernal/index.mjs",
      "require": "./dist/kernal/index.cjs"
    },
    "./kernal": {
      "types": "./dist/kernal/index.d.ts",
      "import": "./dist/kernal/index.mjs",
      "require": "./dist/kernal/index.cjs"
    },
    "./ReaderHub": {
      "types": "./dist/ReaderHub.d.ts",
      "import": "./dist/ReaderHub.mjs",
      "require": "./dist/ReaderHub.cjs"
    },
    "./kernal/*": {
      "types": "./dist/kernal/*.d.ts",
      "import": "./dist/kernal/*.mjs",
      "require": "./dist/kernal/*.cjs"
    },
    "./mediaTypes/*": {
      "types": "./dist/mediaTypes/*.d.ts",
      "import": "./dist/mediaTypes/*.mjs",
      "require": "./dist/mediaTypes/*.cjs"
    },
    "./pdfjs": "./dist/pdfjs/package.json",
    "./pdfjs/*": "./dist/pdfjs/*",
    "./global.d.ts": "./global.d.ts",
    "./types.d.ts": "./types.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "global.d.ts",
    "types.d.ts",
    "LICENSE",
    "README.MD",
    "README.zh.md",
    "docs/logo-64x64.png"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:html": "vite --config samples/html/vite.config.ts",
    "sample:pdf": "vite --config samples/pdf/vite.config.ts"
  },
  "keywords": [
    "reader",
    "pdf",
    "html",
    "foxycape"
  ],
  "dependencies": {
    "events": "^3.3.0",
    "highlight.js": "^11.12.0",
    "hotkeys-js": "^4.0.4",
    "js-base64": "^3.9.2",
    "js-logger": "^1.6.1",
    "perfect-debounce": "^2.1.0",
    "scheduler-polyfill": "^1.3.0",
    "spark-md5": "^3.0.2",
    "tslib": "^2.8.1",
    "type-detect": "^4.1.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/node": "^26.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript/typescript6": "^6.0.2",
    "fake-indexeddb": "^6.2.5",
    "glob": "^13.0.6",
    "happy-dom": "^20.11.6",
    "sass": "^1.102.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-require-transform": "^1.0.21",
    "vitest": "^4.1.10"
  }
}

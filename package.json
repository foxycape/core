{
  "name": "@foxycape/core",
  "version": "1.1.3",
  "description": "Browser-side multi-format reader kernel with pluggable parsers, renderers, services, and plugins.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://www.foxycape.com",
  "bugs": {
    "url": "https://github.com/foxycape/core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxycape/core.git"
  },
  "main": "./dist/kernal/index.cjs",
  "module": "./dist/kernal/index.mjs",
  "types": "./dist/kernal/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/kernal/index.d.ts",
      "import": "./dist/kernal/index.mjs",
      "require": "./dist/kernal/index.cjs"
    },
    "./kernal": {
      "types": "./dist/kernal/index.d.ts",
      "import": "./dist/kernal/index.mjs",
      "require": "./dist/kernal/index.cjs"
    },
    "./kernal/*": {
      "types": "./dist/kernal/*.d.ts",
      "import": "./dist/kernal/*.mjs",
      "require": "./dist/kernal/*.cjs"
    },
    "./mediaTypes/*": {
      "types": "./dist/mediaTypes/*.d.ts",
      "import": "./dist/mediaTypes/*.mjs",
      "require": "./dist/mediaTypes/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.MD",
    "README.zh.md",
    "docs/logo-64x64.png"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:html": "vite --config samples/html/vite.config.ts",
    "sample:pdf": "vite --config samples/pdf/vite.config.ts"
  },
  "keywords": [
    "reader",
    "pdf",
    "html",
    "foxycape"
  ],
  "dependencies": {
    "events": "^3.3.0",
    "hotkeys-js": "^3.13.14",
    "js-base64": "^3.7.7",
    "js-logger": "^1.6.1",
    "localforage": "^1.10.0",
    "perfect-debounce": "^1.0.0",
    "scheduler-polyfill": "^1.3.0",
    "spark-md5": "^3.0.2",
    "type-detect": "^4.1.0",
    "ua-parser-js": "^2.0.4",
    "xxhashjs": "^0.2.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@types/node": "^24.0.12",
    "@types/ua-parser-js": "^0.7.39",
    "@types/xxhashjs": "^0.2.4",
    "glob": "^11.0.3",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-require-transform": "^1.0.21",
    "vitest": "^4.1.10"
  }
}
